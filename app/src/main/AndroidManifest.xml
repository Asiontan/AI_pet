<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.openxmlformats.org/tools">
    
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务基础权限（兼容旧版本） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14（targetSdk 34）要求按类型声明前台服务权限，这里使用通用的 dataSync 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Android 11+ 包可见性：允许查询所有已安装应用名称 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- 抖音：手势识别 FIST 手势启动 -->
        <package android:name="com.ss.android.ugc.aweme" />
        <!-- 微信：手势识别 THUMBS_UP 手势启动 -->
        <package android:name="com.tencent.mm" />
    </queries>
    
    <application
        android:name=".PetApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Pet Desktop"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pet">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".MotionPreviewActivity"
            android:exported="false"
            android:label="动作预览" />

        <activity
            android:name=".ModelSwitchActivity"
            android:exported="false"
            android:label="切换模型" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="云端账号" />

        <activity
            android:name=".chat.ChatDialogActivity"
            android:exported="false"
            android:label="和宠物聊天"
            android:theme="@style/Theme.Pet.ChatDialog"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name="com.example.pet.PetAccessibilityService"
            android:exported="true"
            android:label="Pet Desktop 手势控制"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name="com.pet.pet.service.PetForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".chat.ChatMiniService"
            android:enabled="true"
            android:exported="false" />

        <!-- 接收 pet-service 广播：关闭 Mini 条 + 打开全屏聊天 / 关闭所有聊天UI -->
        <receiver
            android:name=".OpenChatReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.pet.action.CLOSE_MINI_AND_OPEN_CHAT" />
                <action android:name="com.pet.action.CLOSE_ALL_CHAT_UI" />
                <action android:name="com.pet.action.SWIPE_DOWN" />
            </intent-filter>
        </receiver>
        
    </application>
    
</manifest>
